# 가스 예측과 측정 패턴 결과를 쉬운 세 화면으로 안내
# 저장 모델의 추론 서비스 및 다운로드 내용 유지

import hashlib

import altair as alt
import pandas as pd
import streamlit as st

from .service import (
    MODEL_PATH, DETECTOR_PATH, MODEL_SHA, DETECTOR_SHA, FEATURES, GASES,
    THRESHOLD, InputError, load_models, read_upload, analyze, downloads,
    reset_on_upload_change,
)

PAGES = ["데이터 분석", "분석 결과", "상세 분석"]
GAS_NAMES = dict(zip(GASES.values(), [
    "에탄올 (Ethanol)", "에틸렌 (Ethylene)", "암모니아 (Ammonia)",
    "아세트알데하이드 (Acetaldehyde)", "아세톤 (Acetone)", "톨루엔 (Toluene)",
]))


# 파일 버전별 모델 캐시 유지
@st.cache_resource(show_spinner="분석 준비 중…")
def cached_models(model_signature, detector_signature):
    return load_models()


# 작은 화면에서도 읽을 수 있는 기본 스타일
def style():
    st.markdown("""<style>
    .stApp {background:#f5f7fb;color:#17283b}
    [data-testid="stSidebar"] {background:#102b42}
    [data-testid="stSidebar"] * {color:#edf4fb}
    .block-container {max-width:1150px;padding-top:2rem}
    h1,h2,h3 {letter-spacing:-.035em}
    .hero {background:#102b42;border-radius:18px;padding:28px;margin-bottom:24px}
    .hero h1 {color:white;font-size:32px;padding:0 0 12px}
    .hero p {color:#d1e1ef;line-height:1.7;margin:0}
    [data-testid="stMetric"] {background:white;border:1px solid #dce5ef;border-radius:12px;padding:18px}
    [data-testid="stMetricValue"] {font-size:28px!important}
    [data-testid="stMetricLabel"] p {white-space:normal!important}
    button[kind="primary"] {background:#126e82;border-color:#126e82}
    div[data-testid="stAlert"] {border-radius:12px}
    @media(max-width:700px) {
      .block-container {padding:4rem 1rem 1rem}
      .hero {padding:20px}.hero h1 {font-size:26px}
      .st-key-result_metrics [data-testid="stHorizontalBlock"] {display:grid;grid-template-columns:1fr}
      .st-key-result_metrics [data-testid="stColumn"] {width:100%!important;min-width:0}
    }
    </style>""", unsafe_allow_html=True)


# 실제 결과의 개수로 요약 카드 구성
def result_metrics(result):
    summary = result["summary"]
    with st.container(key="result_metrics"):
        a, b, c = st.columns(3)
        a.metric("분석 완료 · 측정값", f"{summary['input_rows']:,}개")
        b.metric("AI가 예측한 가스", f"{summary['predicted_classes']}종")
        c.metric("기준과 다른 구간", f"{summary['alert_windows']}개"
                 if summary["valid_windows"] else "확인 불가")


# 가스 이름과 개수·비율을 가로 막대로 표시
def gas_chart(result):
    table = result["counts"].assign(label=lambda frame: frame.gas.map(GAS_NAMES))
    chart = alt.Chart(table).mark_bar(color="#167c91", cornerRadiusEnd=4).encode(
        y=alt.Y("label:N", title="예측 가스", sort=list(GAS_NAMES.values()),
                axis=alt.Axis(labelLimit=310)),
        x=alt.X("n:Q", title="예측된 측정값 수 (개)", axis=alt.Axis(tickMinStep=1)),
        tooltip=[alt.Tooltip("label:N", title="가스"), alt.Tooltip("n:Q", title="개수"),
                 alt.Tooltip("proportion:Q", title="전체 예측 중 비율", format=".1%")],
    ).properties(height=290, title="가스별 예측 분포")
    st.altair_chart(chart, width="stretch")


# 패턴 상태와 다음 행동을 함께 안내
def drift_notice(result):
    summary = result["summary"]
    st.subheader("센서 측정 패턴 확인")
    if summary["alert_windows"]:
        st.warning("⚠️ 기존 기준과 다른 측정 패턴이 발견됐어요.")
        st.write("가스 구성이나 측정 데이터의 묶음 방식도 영향을 줄 수 있습니다. 센서 고장이 확정된 것은 아닙니다.")
        action = "측정 조건을 확인하고, 필요하면 기준 가스로 다시 측정하거나 AI 모델의 분류 성능을 점검하세요."
    elif not summary["valid_windows"]:
        if summary["input_rows"] < 100:
            st.info("측정 패턴을 확인하려면 데이터가 더 필요해요.")
            action = "패턴 분석에는 최소 100개의 센서 데이터가 필요합니다. 가스 예측 결과는 확인할 수 있습니다."
        else:
            st.info("입력 데이터의 일부 값 때문에 측정 패턴을 확인할 수 없어요.")
            action = "상세 분석에서 확인 불가 사유를 확인하고, 누락된 센서 값을 점검하세요."
    else:
        st.success("기존 기준과 큰 차이가 감지되지 않았어요.")
        action = "현재 설정된 기준에서 큰 차이는 확인되지 않았습니다. 다만 분류 정확도를 보장하는 결과는 아닙니다."
    if summary["invalid_windows"]:
        st.caption(f"{summary['invalid_windows']}개 구간은 확인할 수 없습니다. 상세 분석에서 사유를 확인하세요.")
    st.subheader("다음에 할 일")
    st.write(action)


# 원래 점수와 고정 기준선을 상세 화면에 표시
def drift_chart(result):
    valid = result["windows"].dropna(subset=["score"])
    if valid.empty:
        st.info("표시할 측정 패턴 차이 점수가 없습니다.")
        return
    st.write("과거 기준 데이터와 현재 측정 패턴의 차이를 비교합니다.")
    base = alt.Chart(valid).encode(
        x=alt.X("window:Q", title="분석 구간 번호 · 입력 행 순서", axis=alt.Axis(tickMinStep=1)),
        y=alt.Y("score:Q", title="측정 패턴 차이 점수 (RFF-MMD²)"),
        tooltip=["window:Q", "start_position:Q", "end_position:Q", "score:Q", "status:N"],
    )
    rule = alt.Chart(pd.DataFrame({"threshold": [THRESHOLD]})).mark_rule(
        color="#c43d49", strokeDash=[6, 4]).encode(y="threshold:Q")
    alerts = base.transform_filter(alt.datum.alert == True).mark_point(color="#d77330", size=100)
    st.altair_chart((base.mark_line(point=True, color="#167c91") + rule + alerts).properties(
        height=280, title="구간별 점수 · 빨간 점선은 변화 감지 기준"), width="stretch")
    st.caption("점수는 확률이나 예상 정확도가 아닙니다. 100행은 실제 시간 길이를 뜻하지 않습니다.")


# 업로드 정답이 있는 경우에만 기존 정책으로 평가 표시
def optional_evaluation(result):
    evaluation = result["evaluation"]
    if evaluation is None:
        st.info("정답 gas 열이 없어 실제 분류 성능을 계산하지 않았습니다.")
        return
    correct = int((result["rows"].gas == result["rows"].predicted_gas_id).sum())
    st.write(f"업로드한 정답 데이터 기준 {len(result['rows']):,}개 중 {correct:,}개를 올바르게 분류했습니다.")
    st.caption("기존 학습 자료일 수 있는 업로드 정답과의 비교입니다. 독립적인 미래 시기 성능이 아닙니다.")
    a, b = st.columns(2)
    a.metric("정답과 일치한 비율 · Accuracy", f"{evaluation['accuracy']:.2%}")
    b.metric("가스별 분류 성능 종합 점수 · Macro F1", f"{evaluation['macro_f1']:.2%}")
    st.caption(f"Macro F1 계산 대상: 정답에 존재하는 {evaluation['supported_classes']}종. support는 정답 표본 수입니다.")
    if evaluation["supported_classes"] < 6:
        st.warning("일부 가스의 정답이 없어 이 결과만으로 가스 6종 전체의 분류 성능을 판단할 수 없습니다.")
    matrix = evaluation["confusion"].rename_axis("실제 가스").reset_index().melt(
        id_vars="실제 가스", var_name="예측 가스", value_name="개수")
    heat = alt.Chart(matrix).encode(
        x=alt.X("예측 가스:N", sort=list(GASES.values()), axis=alt.Axis(labelAngle=-35)),
        y=alt.Y("실제 가스:N", sort=list(GASES.values())), tooltip=["실제 가스:N", "예측 가스:N", "개수:Q"],
    )
    st.altair_chart((heat.mark_rect().encode(color=alt.Color("개수:Q", scale=alt.Scale(scheme="blues")))
                    + heat.mark_text().encode(text="개수:Q")).properties(
                        height=300, title="실제 가스와 AI 예측 비교 · Confusion Matrix"), width="stretch")
    st.dataframe(evaluation["per_class"], hide_index=True, width="stretch")


# 모델 지문과 해석 범위 제공
def model_notes():
    st.write("분류: 공식 Model A · B_SVM_balanced · SVM(RBF), Batch 1–6 학습")
    st.code(f"분류 모델 SHA-256: {MODEL_SHA}\n감지기 SHA-256: {DETECTOR_SHA}\n"
            f"감지기 버전: rff_mmd_v1\n고정 임계값: {THRESHOLD}\n감지 창: 100행")
    st.write("가스 구성·구간 구성·측정 조건이 점수에 영향을 줄 수 있습니다. 실제 센서 드리프트나 장비 이상을 확정하지 않습니다.")
    st.caption("Batch 9–10은 반복 사용한 회고적 자료이며 독립 Test가 아닙니다. 자동 재학습이나 모델 교체는 수행하지 않습니다.")


# 상세 표와 다운로드를 접힌 영역으로 분리
def details(result):
    with st.expander("가스별 분포와 행별 예측 결과"):
        gas_chart(result)
        st.dataframe(result["counts"], hide_index=True, width="stretch")
        selected = st.number_input("확인할 입력 행", min_value=1, max_value=len(result["rows"]), value=1, step=1)
        st.dataframe(result["rows"].iloc[[int(selected) - 1]], hide_index=True, width="stretch")
        st.dataframe(result["rows"], hide_index=True, width="stretch")
    with st.expander("측정 패턴 점수와 구간별 결과 · MMD²"):
        drift_chart(result)
        st.code(f"고정 임계값: {THRESHOLD}")
        st.write(f"분석한 구간: {result['summary']['valid_windows']}개 · "
                 f"패턴 분석에서 제외된 측정값: {result['summary']['excluded_tail_rows']}개")
        st.dataframe(result["windows"], hide_index=True, width="stretch")
    with st.expander("정답 기반 성능 평가"):
        optional_evaluation(result)
    with st.expander("모델 정보와 검증 범위"):
        model_notes()
    with st.expander("분석 결과 다운로드", expanded=True):
        labels = ["가스 예측 결과 다운로드", "측정 패턴 분석 결과 다운로드", "전체 분석 요약 다운로드"]
        for label, (name, data) in zip(labels, downloads(result).items()):
            st.download_button(label, data=data, file_name=name, mime="text/csv",
                               key="download_" + name, on_click="ignore", width="stretch")
        st.caption("입력 행 순서와 기존 CSV 내용을 유지합니다. 100행 미만의 패턴 CSV에는 제목 행만 포함됩니다.")
        st.dataframe(pd.DataFrame([result["summary"]]), hide_index=True, width="stretch")


# 업로드 상태를 유지하며 분석 후 결과 화면으로 이동
def main():
    st.set_page_config(page_title="가스 센서 AI 분석", page_icon="◈", layout="wide")
    style()
    if st.session_state.pop("show_results", False):
        st.session_state["page"] = PAGES[1]
    with st.sidebar:
        st.markdown("### 가스 센서 AI 분석")
        page = st.radio("분석 화면", PAGES, key="page")
        st.caption("① 파일 선택 → ② 분석 시작 → ③ 결과 확인")
    st.markdown("<div class='hero'><h1>가스 센서 AI 분석</h1>"
                "<p>센서 데이터를 업로드하면 AI가 가스 종류를 분석하고,<br>"
                "기존 측정 패턴과 달라진 부분을 확인합니다.</p></div>", unsafe_allow_html=True)
    with st.expander("센서 데이터 선택", expanded=page == PAGES[0]):
        upload = st.file_uploader("센서 데이터 CSV", type=["csv"], key="sensor_csv", max_upload_size=20)
        payload = upload.getvalue() if upload is not None else None
        digest = hashlib.sha256(payload).hexdigest() if payload is not None else None
        reset_on_upload_change(st.session_state, digest)
        preview = None
        if payload is not None:
            try:
                preview = read_upload(payload)
                st.success(f"{len(preview.features):,}개의 센서 데이터가 준비되었습니다.")
            except InputError as exc:
                st.error(str(exc))
        submitted = st.button("분석 시작", key="analyze", type="primary", disabled=preview is None, width="stretch")
        with st.expander("파일 형식 안내"):
            st.write("UTF-8 CSV · f001~f128 센서 열 필수 · 20MB / 20,000행 이하. 정답 gas 열은 선택 사항입니다.")
            st.caption("gas: 1 에탄올, 2 에틸렌, 3 암모니아, 4 아세트알데하이드, 5 아세톤, 6 톨루엔. "
                       "일부 결측값은 저장 모델의 기존 기준으로 처리합니다. 알 수 없는 열·중복 열·비수치·무한대·전체 결측은 허용하지 않습니다.")
        st.caption("파일은 세션 메모리에서 처리합니다. 파일 변경·제거 시 이전 결과를 비웁니다.")
    if submitted:
        st.session_state.pop("analysis", None)
        try:
            signature = tuple((p.stat().st_mtime_ns, p.stat().st_size) for p in [MODEL_PATH, DETECTOR_PATH])
            with st.spinner("가스 종류와 측정 패턴 분석 중…"):
                st.session_state["analysis"] = analyze(preview, cached_models(*signature))
            st.session_state.pop("analysis_error", None)
            st.session_state["show_results"] = True
            st.rerun()
        except (OSError, ValueError, RuntimeError, OverflowError):
            st.session_state["analysis_error"] = "분석을 완료하지 못했습니다. 저장 모델과 센서 입력값을 확인해 주세요."
    if "analysis_error" in st.session_state:
        st.error(st.session_state["analysis_error"])
    result = st.session_state.get("analysis")
    st.subheader(page)
    if page == PAGES[0]:
        st.write("CSV를 선택한 뒤 분석 시작을 눌러 주세요. 결과에서 가스 예측, 측정 패턴, 다음 행동을 확인할 수 있습니다.")
        st.caption("가스 예측은 한 행부터 가능합니다. 측정 패턴 비교에는 최소 100행이 필요합니다.")
    elif result is None:
        st.info("데이터 분석 화면에서 CSV를 업로드하고 분석을 시작해 주세요.")
    elif page == PAGES[1]:
        result_metrics(result)
        st.subheader("AI 가스 분석 결과")
        counts = result["counts"]
        leaders = counts[counts.n == counts.n.max()]
        names = ", ".join(leaders.gas.map(GAS_NAMES))
        st.write(f"가장 많이 예측된 가스: **{names}**" + (" · 공동 최다" if len(leaders) > 1 else ""))
        top = leaders.iloc[0]
        st.write(f"각 {int(top.n):,}개 / 전체 {result['summary']['input_rows']:,}개 ({top.proportion:.1%})"
                 if len(leaders) > 1 else f"{int(top.n):,}개 / 전체 {result['summary']['input_rows']:,}개 ({top.proportion:.1%})")
        gas_chart(result)
        st.caption("모델이 예측한 가스 종류입니다. 실제 가스 존재 여부를 확정한 결과는 아닙니다.")
        drift_notice(result)
        st.caption("행별 결과, 기술 정보, 정답 기반 평가 및 다운로드는 상세 분석에서 확인할 수 있습니다.")
    else:
        details(result)
    st.divider()
    st.caption("연구용 분석 서비스 · 측정 패턴 변화는 센서 고장이나 분류 정확도를 확정하지 않음")


if __name__ == "__main__":
    main()
